# Neon Postgres. Runtime uses the pooled URL; migrations use the direct URL.
# Keep both server only. Never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional dedicated RPC endpoint for server-side verification.
# Defaults to the public Robinhood Chain testnet RPC when unset.
ROBINHOOD_TESTNET_RPC_URL=

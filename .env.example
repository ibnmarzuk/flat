# Optional dedicated RPC endpoint for server-side verification.
# Defaults to the public Robinhood Chain testnet RPC when unset.
ROBINHOOD_TESTNET_RPC_URL=

# Configure these after the dedicated FlatQuest Supabase project is provisioned.
# The current prototype does not require these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never expose this key through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=
